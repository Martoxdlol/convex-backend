# systemd unit for the conductor process on a plain VM.

[Unit]
Description=Convex Native Conductor
Documentation=https://github.com/get-convex/convex-backend/blob/main/convex-native/DEPLOYMENT.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=convex
Group=convex
ExecStart=/usr/local/bin/convex-conductor

Environment=CONVEX_MODE=conductor
# Comma-separated worker endpoints. Update by re-templating the
# unit file + `systemctl daemon-reload && systemctl restart` — or
# load from /etc/convex/conductor.env via EnvironmentFile= below.
Environment="CONVEX_WORKER_ENDPOINTS=http://worker-a:4567,http://worker-b:4567"
# Pin the minimum registry version during a rolling deploy.
Environment=CONVEX_MIN_REGISTRY_VERSION=0.1.0
Environment=RUST_LOG=info

# Swap the inline Environment= lines above for an env file when
# you want `systemctl reload` to pick up worker-list changes
# without restarting:
# EnvironmentFile=/etc/convex/conductor.env

TimeoutStopSec=30
KillSignal=SIGTERM
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
