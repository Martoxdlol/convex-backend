# syntax=docker/dockerfile:1-labs
#
# Phase 5 of convex-native/DISTRIBUTED_PLAN.md: prebuilt
# agnostic backend image. Built from
# `crates/convex_native/src/bin/convex-backend.rs`, which links
# zero `#[convex::*]` code so the backend carries no
# deployer-specific function inventory — workers dial in via
# `WorkerAdmissionService` and ship the handler registry at
# admission time.
#
# Why a distinct Dockerfile rather than reusing
# `self-hosted/docker-build/Dockerfile.backend`:
#
# - Workers join dynamically. The image must boot with an
#   empty native registry and populate it from admission
#   envelopes (substep 5.1 of `convex-native/STATUS.md`).
# - The admission service needs to bind a port the workers
#   can dial; `CONVEX_ADMISSION_BIND_ADDR` defaults to
#   `0.0.0.0:5678` here so deployers don't have to set it
#   explicitly.
# - The worker image ships separately (see `Dockerfile.worker`
#   in this directory). The two roll on independent cadences.
#
# Build:
#   docker build -f convex-native/examples/deploy/docker/Dockerfile.backend \
#                -t getconvex/convex-backend:<tag> .
#
# Run (example):
#   docker run -d --name convex-backend \
#     -e CONVEX_DB_URL=postgres://... \
#     -e CONVEX_ADMISSION_BIND_ADDR=0.0.0.0:5678 \
#     -p 3210:3210 \
#     -p 5678:5678 \
#     getconvex/convex-backend:<tag>

ARG VERGEN_GIT_SHA
ARG VERGEN_GIT_COMMIT_TIMESTAMP

# Dependency-caching stage (cargo-chef). Produces a recipe.json
# from the full workspace so the compile stage below can
# rebuild only what changed when a dev iterates on backend
# source.
FROM lukemathwalker/cargo-chef:latest-rust-1 AS chef
WORKDIR /tmp
COPY rust-toolchain .
RUN rustup self update && rustup toolchain install
COPY --parents crates* Cargo* ./
RUN cargo chef prepare --recipe-path recipe.json --bin convex-backend

# Build stage.
FROM lukemathwalker/cargo-chef:latest-rust-1 AS build
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN <<EOF
printf 'APT::Acquire::Retries "10";\n' > /etc/apt/apt.conf.d/80retries
printf 'APT::Get::Assume-Yes "true";\n' > /etc/apt/apt.conf.d/90forceyes
printf 'DPkg::Lock::Timeout "30";\n' > /etc/apt/apt.conf.d/85timeout
echo 'DEBIAN_FRONTEND=noninteractive' > /etc/environment
apt-get update
apt-get install -y --no-install-recommends cmake libclang-dev libstdc++6 libc6
EOF

RUN cargo install just
WORKDIR /

# Install Node.js from `.nvmrc`. The backend embeds V8 for the
# JS dispatch path; Node is needed so the build pulls the V8
# binaries compiled against the same GLIBC as the runtime
# image.
COPY .nvmrc /nvmrc
RUN <<EOF
NODE_MAJOR=$(cat /nvmrc | cut -d. -f1 | tr -d 'v\n')
curl -fsSL https://deb.nodesource.com/setup_${NODE_MAJOR}.x | bash -
NODE_VERSION=$(cat /nvmrc | tr -d 'v\n')
apt-get install -y --no-install-recommends nodejs=${NODE_VERSION}-1nodesource1
EOF

COPY rust-toolchain /rust-toolchain
RUN rustup self update && rustup toolchain install && cargo search -q convex

WORKDIR /convex
COPY scripts ./scripts
RUN npm ci --prefix scripts/

ENV RUSH_BUILD_CACHE_ENABLED=0
COPY npm-packages ./npm-packages
COPY Justfile ./
RUN --mount=type=cache,target=/convex/npm-packages/common/temp/,sharing=locked \
    just rush install

COPY --from=chef /tmp/recipe.json recipe.json
RUN --mount=type=cache,target=/convex/target/ \
    --mount=type=cache,target=/usr/local/cargo/git/db \
    --mount=type=cache,target=/usr/local/cargo/registry/ \
    cargo chef cook --release --recipe-path recipe.json

COPY . .

ARG VERGEN_GIT_SHA
ARG VERGEN_GIT_COMMIT_TIMESTAMP
ENV VERGEN_GIT_SHA=${VERGEN_GIT_SHA}
ENV VERGEN_GIT_COMMIT_TIMESTAMP=${VERGEN_GIT_COMMIT_TIMESTAMP}
RUN --mount=type=cache,target=/convex/npm-packages/common/temp/,sharing=locked \
    --mount=type=cache,target=/convex/target/ \
    --mount=type=cache,target=/usr/local/cargo/git/db \
    --mount=type=cache,target=/usr/local/cargo/registry/ <<EOF
cargo build --release -p convex_native --bin convex-backend
cp target/release/convex-backend .
cargo build --release -p keybroker --bin generate_key
cp target/release/generate_key .
EOF

ARG debug
RUN if [[ -z "$debug" ]]; then strip ./convex-backend; strip ./generate_key; fi

# Runtime image.
FROM ubuntu:noble
ARG VERGEN_GIT_SHA
LABEL org.opencontainers.image.source=https://github.com/get-convex/convex-backend
LABEL org.opencontainers.image.revision=${VERGEN_GIT_SHA}
LABEL org.opencontainers.image.description="Prebuilt convex-backend for the distributed-native topology (convex-native/DISTRIBUTED_PLAN.md Phase 5). Workers register via WorkerAdmissionService; the backend carries no deployer-specific function inventory."

WORKDIR /convex

RUN --mount=type=cache,target=/var/cache/apt \
    --mount=type=cache,target=/var/lib/apt,sharing=locked <<EOF
apt-get update
apt-get install -y --no-install-recommends libclang1 curl ca-certificates
EOF

COPY --from=build /usr/bin/node /usr/bin/node
COPY --from=build /usr/bin/npm /usr/bin/npm
COPY --from=build /usr/lib/node_modules/npm /usr/lib/node_modules/npm
RUN ln -sf /usr/lib/node_modules/npm/bin/npm-cli.js /usr/bin/npm && chmod +x /usr/bin/npm
RUN ln -sf /usr/lib/node_modules/npm/bin/npx-cli.js /usr/bin/npx && chmod +x /usr/bin/npx

COPY --from=build --chmod=744 /convex/convex-backend .
COPY --from=build --chmod=744 /convex/generate_key .

VOLUME /convex/data

# Default CONVEX_ADMISSION_BIND_ADDR so `docker run` without
# extra env vars already serves the admission port. Operators
# override via `-e CONVEX_ADMISSION_BIND_ADDR=host:port`.
ENV CONVEX_ADMISSION_BIND_ADDR=0.0.0.0:5678

ENTRYPOINT ["./convex-backend"]

# Public surfaces:
# 3210 — HTTP + WebSocket (clients hit here).
# 3211 — dashboard / admin HTTP.
# 5678 — WorkerAdmissionService (workers dial from their
#        CONVEX_BACKEND_ENDPOINT).
EXPOSE 3210
EXPOSE 3211
EXPOSE 5678
